--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -3,10 +3,18 @@
 
 SET(CMAKE_CXX_FLAGS "-std=c++11 -Wall -Werror -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unknown-pragmas")
 
-IF(DEFINED ENV{ARM_ARCHITECTURE})
+STRING(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" FAST_TARGET_PROCESSOR)
+IF(FAST_TARGET_PROCESSOR MATCHES "^(aarch64|arm64)$")
+  SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -O3 -march=armv8-a+simd")
+  SET(FAST_USE_NEON TRUE)
+ELSEIF(FAST_TARGET_PROCESSOR MATCHES "^arm")
 	SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -O3 -mfpu=neon -march=armv7-a")
+  SET(FAST_USE_NEON TRUE)
+ELSEIF(FAST_TARGET_PROCESSOR MATCHES "^(x86_64|amd64|i[3-6]86)$")
+	SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -O3 -mmmx -msse -msse -msse2 -msse3 -mssse3 -fomit-frame-pointer")
+  SET(FAST_USE_NEON FALSE)
 ELSE()
-	SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -O3 -mmmx -msse -msse -msse2 -msse3 -mssse3 -fomit-frame-pointer")
+  MESSAGE(FATAL_ERROR "Unsupported FAST target processor: ${CMAKE_SYSTEM_PROCESSOR}")
 ENDIF()
 
 find_package(catkin_simple REQUIRED)
@@ -26,7 +34,7 @@
   src/nonmax_3x3.cpp
   )
 
-IF(DEFINED ENV{ARM_ARCHITECTURE})
+IF(FAST_USE_NEON)
   LIST(APPEND SOURCES ${PROJECT_SOURCE_DIR}/src/faster_corner_9_neon.cpp)
 ELSE()
   LIST(APPEND SOURCES ${PROJECT_SOURCE_DIR}/src/faster_corner_10_sse.cpp)
