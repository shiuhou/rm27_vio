set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT IS_DIRECTORY "$ENV{SCHURVINS_CROSS}" OR NOT IS_DIRECTORY "$ENV{SCHURVINS_SYSROOT}")
  message(FATAL_ERROR "Set SCHURVINS_CROSS and SCHURVINS_SYSROOT to read-only Bionic cross toolchain/sysroot")
endif()
set(CMAKE_SYSROOT "$ENV{SCHURVINS_SYSROOT}")
set(CMAKE_C_COMPILER "$ENV{SCHURVINS_CROSS}/usr/bin/aarch64-linux-gnu-gcc-7")
set(CMAKE_CXX_COMPILER "$ENV{SCHURVINS_CROSS}/usr/bin/aarch64-linux-gnu-g++-7")
set(CMAKE_CXX_FLAGS_INIT "-B$ENV{SCHURVINS_CROSS}/usr/aarch64-linux-gnu/bin")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${CMAKE_SYSROOT}/usr/lib/gcc/aarch64-linux-gnu/7 -Wl,-rpath-link,${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu -Wl,-rpath-link,${CMAKE_SYSROOT}/lib/aarch64-linux-gnu")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
