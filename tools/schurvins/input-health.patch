+void FrameHandlerBase::invalidateInput(int64_t sensor_ns)
+{
+  rm27::eventAtTimestamp("input_invalidated",sensor_ns);
+  resetAll();
+  // Startup reset may have no frame pointers, so resetCommon's guarded clear
+  // is insufficient here. No previous-epoch sample may seed a fresh filter.
+  if(imu_handler_)imu_handler_->reset();
+}
