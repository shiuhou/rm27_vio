+void SvoInterface::rejectImuInput(rm27::InputFault fault,int64_t camera_ns,int64_t source_ns)
+{
+  rm27::eventAtTimestamp(rm27::inputFaultName(fault),camera_ns,-1,
+      {double(static_cast<int>(fault)),automatic_reinitialization_?1.0:0.0},source_ns,"imu0");
+  // Keep lock ordering identical to imuCallback: health mutex, then IMU mutex.
+  std::lock_guard<std::mutex> lock(input_health_mutex_);
+  svo_->invalidateInput(camera_ns);
+  imu_input_order_.reset();pending_imu_fault_=rm27::InputFault::None;pending_imu_fault_ns_=-1;
+  input_failure_paused_=!automatic_reinitialization_;
+  // Paused/insufficient Info reaches the observer on its receipt clock. Never
+  // publish a pose here, and return from acceptInput before the normal path.
+  visualizer_->publishSvoInfo(svo_.get(),camera_ns);
+  if(automatic_reinitialization_)svo_->start();
+}
+
+bool SvoInterface::acceptInput(const int64_t timestamp_nanoseconds)
+{
+  const auto camera_health=camera_input_order_.accept(timestamp_nanoseconds);
+  if(camera_health!=rm27::InputFault::None) {
+    // Boundary rejection precedes getRelativeRotationPrior/getMeasurements.
+    // Preserve the original integer source time; never sort or retimestamp it.
+    rm27::eventAtTimestamp(rm27::inputFaultName(camera_health),timestamp_nanoseconds,-1,
+        {double(static_cast<int>(camera_health)),automatic_reinitialization_?1.0:0.0});
+    return false;
+  }
+  if(input_failure_paused_) {
+    visualizer_->publishSvoInfo(svo_.get(),timestamp_nanoseconds);return false;
+  }
+  if(!imu_handler_)return true;
+  rm27::InputFault pending;int64_t pending_ns;
+  {
+    std::lock_guard<std::mutex> lock(input_health_mutex_);
+    pending=pending_imu_fault_;pending_ns=pending_imu_fault_ns_;
+  }
+  if(pending!=rm27::InputFault::None) {
+    rejectImuInput(pending,timestamp_nanoseconds,pending_ns);return false;
+  }
+  const double end=timestamp_nanoseconds*common::conversions::kNanoSecondsToSeconds;
+  const bool ready=imu_handler_->waitTill(end);
+  ImuMeasurements samples=imu_handler_->getMeasurementsCopy();
+  std::reverse(samples.begin(),samples.end()); // original storage is newest-first
+  for(auto& sample:samples)sample.timestamp_+=imu_handler_->imu_calib_.delay_imu_cam;
+  const bool prior_frame=bool(svo_->getLastFrames());
+  const double begin=prior_frame?svo_->getLastFrames()->getMinTimestampSeconds():
+      (samples.empty()?end:samples.front().timestamp_);
+  const auto health=ready?rm27::imuIntervalHealth(samples,begin,end):rm27::InputFault::ImuCoverage;
+  if(health!=rm27::InputFault::None) {
+    // Lack of startup coverage remains initialization. Once a state exists,
+    // incomplete input invalidates it and clears every cross-epoch buffer.
+    if(!prior_frame && health==rm27::InputFault::ImuCoverage) {
+      rm27::eventAtTimestamp("input_waiting_imu_coverage",timestamp_nanoseconds);return false;
+    }
+    rejectImuInput(health,timestamp_nanoseconds);return false;
+  }
+  return true;
+}
