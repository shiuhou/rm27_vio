+// RM27 input guards. Sensor order is preserved; no sorting or interpolation.
+#pragma once
+#include <cstdint>
+#include <cstddef>
+#include <cmath>
+namespace rm27 {
+// This is the estimator's existing strict Prediction(dt < .015) bound, not a
+// flight safety policy or a sensor noise parameter.
+constexpr int64_t schur_max_imu_gap_ns=15000000;
+constexpr double schur_max_imu_gap_s=.015;
+enum class InputFault { None=0, CameraTimestamp=1, CameraOrder=2,
+    ImuNonfinite=3, ImuOrder=4, ImuGap=5, ImuCoverage=6 };
+inline const char* inputFaultName(InputFault fault) {
+    switch(fault) {
+      case InputFault::CameraTimestamp:return "input_rejected_camera_timestamp";
+      case InputFault::CameraOrder:return "input_rejected_camera_order";
+      case InputFault::ImuNonfinite:return "input_invalid_imu_nonfinite";
+      case InputFault::ImuOrder:return "input_invalid_imu_order";
+      case InputFault::ImuGap:return "input_invalid_imu_gap";
+      case InputFault::ImuCoverage:return "input_invalid_imu_coverage";
+      default:return "input_healthy";
+    }
+}
+class CameraInputOrder {
+ public:
+    int64_t latest=-1;
+    InputFault accept(int64_t timestamp) {
+      if(timestamp<=0)return InputFault::CameraTimestamp;
+      if(latest>=timestamp)return InputFault::CameraOrder;
+      latest=timestamp;return InputFault::None;
+    }
+};
+class ImuInputOrder {
+ public:
+    int64_t latest=-1;
+    void reset(){latest=-1;}
+    InputFault accept(int64_t timestamp,bool finite) {
+      if(timestamp<=0 || !finite)return InputFault::ImuNonfinite;
+      if(latest>=timestamp)return InputFault::ImuOrder;
+      const bool gap=latest>=0 && timestamp-latest>=schur_max_imu_gap_ns;
+      latest=timestamp;
+      return gap?InputFault::ImuGap:InputFault::None;
+    }
+};
+// Samples must be in the original chronological order. Camera time is mapped
+// by the explicitly loaded calibration before this function is called.
+template<class Samples>
+InputFault imuIntervalHealth(const Samples& samples,double begin,double end) {
+    if(!std::isfinite(begin) || !std::isfinite(end) || end<begin || samples.size()<2)
+      return InputFault::ImuCoverage;
+    if(!std::isfinite(samples.front().timestamp_) || !std::isfinite(samples.back().timestamp_))
+      return InputFault::ImuNonfinite;
+    if(samples.front().timestamp_>begin || samples.back().timestamp_<end)
+      return InputFault::ImuCoverage;
+    for(size_t i=0;i<samples.size();++i) {
+      const auto& sample=samples[i];
+      if(!std::isfinite(sample.timestamp_) || !sample.angular_velocity_.allFinite()
+          || !sample.linear_acceleration_.allFinite())return InputFault::ImuNonfinite;
+      if(i==0)continue;
+      const double dt=sample.timestamp_-samples[i-1].timestamp_;
+      if(dt<=0)return InputFault::ImuOrder;
+      // Check exactly the intervals which the estimator will use. Older
+      // startup/history samples outside the requested range do not imply a
+      // current gap; they are still checked above for finite values and order.
+      if(sample.timestamp_>begin && samples[i-1].timestamp_<end && dt>=schur_max_imu_gap_s)
+        return InputFault::ImuGap;
+    }
+    return InputFault::None;
+}
+}  // namespace rm27
