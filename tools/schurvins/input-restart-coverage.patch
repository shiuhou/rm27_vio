+// A reset discards the old epoch's IMU buffer. Until a first frame is
+// accepted, incomplete new-epoch coverage is initialization, not another
+// sensor failure. The same missing coverage after a state exists is invalid.
+inline bool waitForInitialImuCoverage(InputFault health,bool has_previous_frame) {
+    return health==InputFault::ImuCoverage && !has_previous_frame;
+}
