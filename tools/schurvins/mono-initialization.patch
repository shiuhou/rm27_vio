+// RM27 visual-inertial bootstrap. Independent of truth and output adapters.
+// Equations: p_j-p_i=v_i dt+g dt^2/2+alpha, v_j-v_i=g dt+beta.
+#pragma once
+#include <svo/common/frame.h>
+#include <svo/imu_handler.h>
+#include <Eigen/Cholesky>
+#include <Eigen/SVD>
+#include <Eigen/Geometry>
+#include <vector>
+namespace rm27 {
+using V3 = Eigen::Vector3d;
+using M3 = Eigen::Matrix3d;
+inline Eigen::Quaterniond expq(const V3& x) {
+  const double a=x.norm();
+  return a<1e-12 ? Eigen::Quaterniond(1,x.x()/2,x.y()/2,x.z()/2).normalized()
+                 : Eigen::Quaterniond(Eigen::AngleAxisd(a,x/a));
+}
+inline V3 logq(Eigen::Quaterniond q) {
+  q.normalize(); if(q.w()<0)q.coeffs()*=-1;
+  Eigen::AngleAxisd aa(q); return aa.axis()*aa.angle();
+}
+struct MonoAlignmentPolicy {
+  size_t min_frames=31, max_frames=61;
+  double min_span_s=1.5, max_imu_gap_s=.015, min_excitation_mps2=.25;
+  double gravity_mps2=9.81007, gravity_tolerance_mps2=1.0;
+  double max_gyro_bias_rps=.2, max_accel_bias_mps2=1.0;
+  double max_residual_mps=.05, min_singular_ratio=1e-6;
+  double max_rotation_residual_rad=.02, min_imu_translation_m=.05;
+};
+struct MonoPose {
+  EIGEN_MAKE_ALIGNED_OPERATOR_NEW
+  double t; V3 camera; Eigen::Quaterniond q; svo::ImuMeasurements imu;
+};
+struct Preintegral {
+  EIGEN_MAKE_ALIGNED_OPERATOR_NEW
+  double dt=0; V3 alpha=V3::Zero(),beta=V3::Zero();
+  M3 ja=M3::Zero(),jb=M3::Zero(); Eigen::Quaterniond q=Eigen::Quaterniond::Identity();
+};
+struct MonoAlignmentResult {
+  EIGEN_MAKE_ALIGNED_OPERATOR_NEW
+  bool accepted=false; const char* reason="WINDOW_SHORT";
+  double scale=0, excitation=0, residual=0, singular_ratio=0;
+  V3 gravity=V3::Zero(), ba=V3::Zero(), bg=V3::Zero(), velocity=V3::Zero();
+};
+class MonoAlignment {
+ public:
+  EIGEN_MAKE_ALIGNED_OPERATOR_NEW
+  MonoAlignmentPolicy policy;
+  std::vector<MonoPose,Eigen::aligned_allocator<MonoPose>> poses;
+  void reset(){poses.clear();}
+  void add(const svo::FrameBundle::Ptr& f) {
+    MonoPose p; p.t=f->getMinTimestampSeconds(); p.camera=f->at(0)->T_world_cam().getPosition();
+    p.q=f->get_T_W_B().getEigenQuaternion(); p.imu=f->imu_datas_;
+    if(!poses.empty() && p.t<=poses.back().t){reset();return;}
+    poses.push_back(p); if(poses.size()>policy.max_frames)poses.erase(poses.begin());
+  }
+  bool integrate(size_t j,const V3& bg,Preintegral& out) const {
+    const auto& a=poses[j-1];const auto& b=poses[j];
+    const auto& samples=b.imu;out=Preintegral();out.q=a.q;
+    if(samples.size()<2 || samples.front().timestamp_>a.t+1e-6 || samples.back().timestamp_<b.t-1e-6)return false;
+    for(size_t k=1;k<samples.size();++k){
+      const auto& u=samples[k-1];const auto& v=samples[k];
+      const double gap=v.timestamp_-u.timestamp_;
+      if(gap<=0 || gap>policy.max_imu_gap_s)return false;
+      const double l=std::max(a.t,u.timestamp_),r=std::min(b.t,v.timestamp_);if(r<=l)continue;
+      const double dt=r-l,w=((l+r)/2-u.timestamp_)/gap;
+      const V3 gyro=(1-w)*u.angular_velocity_+w*v.angular_velocity_-bg;
+      const V3 acc=(1-w)*u.linear_acceleration_+w*v.linear_acceleration_;
+      const M3 rot=(out.q*expq(gyro*dt/2)).toRotationMatrix();
+      out.alpha+=out.beta*dt+.5*rot*acc*dt*dt;out.ja+=out.jb*dt+.5*rot*dt*dt;
+      out.beta+=rot*acc*dt;out.jb+=rot*dt;out.q=(out.q*expq(gyro*dt)).normalized();out.dt+=dt;
+    }
+    return std::abs(out.dt-(b.t-a.t))<1e-6;
+  }
+  MonoAlignmentResult solve(const V3& t_imu_camera)const {
+    MonoAlignmentResult out;
+    const size_t n=poses.size();if(n<policy.min_frames || poses.back().t-poses.front().t<policy.min_span_s)return out;
+    // Gyro bias is estimated against visual relative rotations, with numerical
+    // Jacobians of the same preintegrator, then all deltas are recomputed.
+    V3 bg=V3::Zero();
+    for(int iteration=0;iteration<3;++iteration){
+      M3 H=M3::Zero();V3 rhs=V3::Zero();
+      for(size_t j=1;j<n;++j){Preintegral p;if(!integrate(j,bg,p)){out.reason="IMU_COVERAGE_OR_GAP";return out;}
+        const V3 e=logq(p.q.inverse()*poses[j].q);M3 J;
+        for(int k=0;k<3;++k){V3 d=V3::Zero();d[k]=1e-5;Preintegral q;integrate(j,bg+d,q);J.col(k)=(logq(q.q.inverse()*poses[j].q)-e)/1e-5;}
+        H+=J.transpose()*J;rhs-=J.transpose()*e;
+      }
+      Eigen::JacobiSVD<M3> gyro_svd(H);
+      if(gyro_svd.singularValues()[2]<1e-12 || gyro_svd.singularValues()[2]/gyro_svd.singularValues()[0]<policy.min_singular_ratio){out.reason="GYRO_UNOBSERVABLE";return out;}
+      const V3 d=H.ldlt().solve(rhs);if(!d.allFinite()){out.reason="GYRO_UNOBSERVABLE";return out;}bg+=d;
+    }
+    out.bg=bg;if(bg.norm()>policy.max_gyro_bias_rps){out.reason="GYRO_BIAS_BOUND";return out;}
+    std::vector<Preintegral,Eigen::aligned_allocator<Preintegral>> deltas(n-1);V3 mean=V3::Zero();
+    for(size_t j=1;j<n;++j){if(!integrate(j,bg,deltas[j-1])){out.reason="IMU_COVERAGE_OR_GAP";return out;}
+      if(logq(deltas[j-1].q.inverse()*poses[j].q).norm()>policy.max_rotation_residual_rad){out.reason="ROTATION_RESIDUAL";return out;}
+      mean+=deltas[j-1].beta/deltas[j-1].dt;}
+    mean/=n-1;double variance=0;for(const auto& p:deltas)variance+=(p.beta/p.dt-mean).squaredNorm();
+    out.excitation=std::sqrt(variance/(n-1));if(out.excitation<policy.min_excitation_mps2){out.reason="EXCITATION_LOW";return out;}
+    double displacement=0;for(const auto& p:poses)displacement=std::max(displacement,(p.camera-poses[0].camera).norm());
+    if(displacement<1e-3){out.reason="PARALLAX_LOW";return out;}
+    V3 g=V3::Zero();Eigen::VectorXd x;double scale=0;V3 ba=V3::Zero();
+    for(int iteration=0;iteration<5;++iteration){
+      const int gd=iteration==0?3:2, cols=3*n+gd+4;M3 basis=M3::Identity();
+      if(iteration){const V3 axis=g.normalized();const V3 u=axis.unitOrthogonal();basis.col(0)=u;basis.col(1)=axis.cross(u);}
+      Eigen::MatrixXd A=Eigen::MatrixXd::Zero(6*(n-1),cols);Eigen::VectorXd b=Eigen::VectorXd::Zero(A.rows());
+      for(size_t j=1;j<n;++j){const auto& p=deltas[j-1];const double dt=p.dt;const int r=6*(j-1),vi=3*(j-1),vj=3*j;
+        A.block<3,3>(r,vi)=-M3::Identity();
+        A.block(r,3*n,3,gd)=-.5*dt*basis.leftCols(gd);
+        A.block<3,3>(r,3*n+gd)=p.ja/dt;
+        A.block<3,1>(r,cols-1)=(poses[j].camera-poses[j-1].camera)/dt;
+        b.segment<3>(r)=(p.alpha+(poses[j].q* t_imu_camera-poses[j-1].q*t_imu_camera))/dt;
+        A.block<3,3>(r+3,vi)=-M3::Identity();A.block<3,3>(r+3,vj)=M3::Identity();
+        A.block(r+3,3*n,3,gd)=-dt*basis.leftCols(gd);A.block<3,3>(r+3,3*n+gd)=p.jb;
+        b.segment<3>(r+3)=p.beta;
+        if(iteration){b.segment<3>(r)+=.5*dt*g;b.segment<3>(r+3)+=dt*g;}
+      }
+      Eigen::VectorXd norms=A.colwise().norm();if((norms.array()<1e-12).any()){out.reason="ALIGNMENT_UNOBSERVABLE";return out;}
+      Eigen::MatrixXd scaled=A*norms.cwiseInverse().asDiagonal();
+      Eigen::JacobiSVD<Eigen::MatrixXd> svd(scaled,Eigen::ComputeThinU|Eigen::ComputeThinV);
+      out.singular_ratio=svd.singularValues().tail(1)[0]/svd.singularValues()[0];
+      if(out.singular_ratio<policy.min_singular_ratio){out.reason="ALIGNMENT_UNOBSERVABLE";return out;}
+      x=norms.cwiseInverse().asDiagonal()*svd.solve(b);
+      if(!x.allFinite()){out.reason="NONFINITE_ALIGNMENT";return out;}
+      out.residual=(A*x-b).norm()/std::sqrt(double(A.rows()));
+      // Preserve tentative solver values on rejection for bounded diagnostics.
+      // These fields do not alter the solve, policy or acceptance decision.
+      out.ba=x.segment<3>(3*n+gd);out.scale=x[cols-1];
+      out.velocity=x.segment<3>(3*(n-1));
+      if(iteration==0){g=x.segment<3>(3*n);out.gravity=g;if(std::abs(g.norm()-policy.gravity_mps2)>policy.gravity_tolerance_mps2){out.reason="GRAVITY_BOUND";return out;}}
+      else {g+=basis.leftCols(2)*x.segment<2>(3*n);out.gravity=g;}
+      g=g.normalized()*policy.gravity_mps2;ba=x.segment<3>(3*n+gd);scale=x[cols-1];
+      out.gravity=g;
+    }
+    // Re-evaluate using the normalized final gravity and estimated biases.
+    // Rotating a fixed accelerometer bias must not masquerade as excitation.
+    mean.setZero();
+    for(const auto& p:deltas)mean+=(p.beta-p.jb*ba)/p.dt;
+    mean/=n-1;variance=0;double residual=0;size_t k=0;
+    for(size_t j=1;j<n;++j){const auto& p=deltas[j-1];const double dt=p.dt;
+      variance+=((p.beta-p.jb*ba)/dt-mean).squaredNorm();
+      const V3 vi=x.segment<3>(3*(j-1)),vj=x.segment<3>(3*j);
+      const V3 dp=scale*(poses[j].camera-poses[j-1].camera)
+          -(poses[j].q*t_imu_camera-poses[j-1].q*t_imu_camera);
+      residual+=(dp/dt-vi-.5*g*dt-(p.alpha-p.ja*ba)/dt).squaredNorm();
+      residual+=(vj-vi-g*dt-(p.beta-p.jb*ba)).squaredNorm();k+=6;
+    }
+    out.excitation=std::sqrt(variance/(n-1));out.residual=std::sqrt(residual/k);
+    if(out.excitation<policy.min_excitation_mps2){out.reason="DEBIASED_EXCITATION_LOW";return out;}
+    const V3 initial=scale*poses.front().camera-poses.front().q*t_imu_camera;
+    double travel=0;for(const auto& p:poses)travel=std::max(travel,(scale*p.camera-p.q*t_imu_camera-initial).norm());
+    if(travel<policy.min_imu_translation_m){out.reason="IMU_TRANSLATION_LOW";return out;}
+    out.scale=scale;out.ba=ba;out.gravity=g;out.velocity=x.segment<3>(3*(n-1));
+    if(scale<=0 || scale>100){out.reason="SCALE_BOUND";return out;}
+    if(ba.norm()>policy.max_accel_bias_mps2){out.reason="ACCEL_BIAS_BOUND";return out;}
+    if(out.residual>policy.max_residual_mps){out.reason="ALIGNMENT_RESIDUAL";return out;}
+    out.accepted=true;out.reason="ACCEPTED";return out;
+  }
+};
+}
