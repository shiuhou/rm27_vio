+bool FrameHandlerMono::tryMetricInitialization() {
+  const auto result=mono_alignment_.solve(cams_->get_T_C_B(0).inverse().getPosition());
+  if(mono_alignment_.poses.size()>=mono_alignment_.policy.min_frames) {
+    rm27::event("mono_alignment_attempt",new_frames_,{double(result.accepted),result.scale,result.excitation,result.residual,result.singular_ratio,result.gravity.norm(),result.ba.norm(),result.bg.norm()});
+    if(!result.accepted)rm27::event((std::string("mono_alignment_rejected_")+result.reason).c_str(),new_frames_);
+  }
+  if(!result.accepted)return false;
+  transformMetricMap(result);
+  const Eigen::Quaterniond rotation=Eigen::Quaterniond::FromTwoVectors(result.gravity,Eigen::Vector3d(0,0,-1));
+  schur_vins_->InitializeMetric(new_frames_, rotation*result.velocity,result.ba,result.bg,rotation*result.gravity);
+  imu_handler_->setGyroscopeBias(result.bg);imu_handler_->setAccelerometerBias(result.ba);
+  schurvinsBackward();
+  stage_=Stage::kInitializing;tracking_quality_=TrackingQuality::kGood;
