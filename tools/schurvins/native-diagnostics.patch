--- a/svo/include/svo/rm27_diagnostics.h
+++ b/svo/include/svo/rm27_diagnostics.h
@@ -0,0 +1,37 @@
+// RM27 bounded diagnostics. No estimator state is modified.
+#pragma once
+#include <svo/common/frame.h>
+#include <chrono>
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <initializer_list>
+#include <mutex>
+namespace rm27 {
+inline void event(const char* kind, const svo::FrameBundle::Ptr& frame,
+                  std::initializer_list<double> values = {}) {
+  const char* path = std::getenv("RM27_NATIVE_EVENTS");
+  if (!path) return;
+  static std::mutex mutex;
+  std::lock_guard<std::mutex> lock(mutex);
+  static std::ofstream stream(path);
+  static unsigned count = 0;
+  if (count++ >= 200000) return;
+  const auto now = std::chrono::steady_clock::now().time_since_epoch();
+  stream << "{\"schema_version\":1,\"kind\":\"" << kind
+         << "\",\"sensor_ns\":" << (frame ? frame->getMinTimestampNanoseconds() : -1)
+         << ",\"bundle_id\":" << (frame ? frame->getBundleId() : -1)
+         << ",\"monotonic_ns\":" << std::chrono::duration_cast<std::chrono::nanoseconds>(now).count()
+         << ",\"values\":[";
+  bool first = true;
+  for (double x : values) {
+    if (!first) stream << ',';
+    first = false;
+    if (std::isfinite(x)) stream << std::setprecision(17) << x;
+    else stream << "null";
+  }
+  stream << "]}\n";
+  stream.flush();
+}
+}
