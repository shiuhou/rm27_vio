+//------------------------------------------------------------------------------
+void FrameHandlerBase::setSchurTrackingQuality(
+    size_t num_inliers, bool visual_correction, bool compare_previous)
+{
+  const auto decision = schur_quality_history_.decide(num_inliers,
+      options_.quality_min_fts, options_.quality_max_fts_drop,
+      last_frames_ && last_frames_->isKeyframe(), visual_correction, compare_previous);
+  tracking_quality_ = decision.good ? TrackingQuality::kGood : TrackingQuality::kInsufficient;
+  // One explicit decision per processed bundle; population=2 means Schur
+  // inliers. visual_correction=0 explicitly identifies unavailable evidence.
+  rm27::event("quality_decision", new_frames_, {
+      double(decision.observations), double(decision.previous_observations),
+      double(decision.minimum), double(decision.maximum_drop),
+      double(decision.has_previous), double(decision.last_was_keyframe),
+      double(decision.visual_correction), 2.0,
+      double(decision.minimum_failed), double(decision.drop_failed),
+      double(tracking_quality_), double(decision.compare_previous)});
 }
 
