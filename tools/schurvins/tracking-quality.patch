+#pragma once
+#include <cstddef>
+
+namespace rm27 {
+// Only Schur's actually accepted visual inliers enter this history. Public
+// num_matches includes seeds and remains an independent frontend statistic.
+struct TrackingQualityDecision {
+  std::size_t observations, previous_observations, minimum, maximum_drop;
+  bool has_previous, last_was_keyframe, visual_correction, compare_previous;
+  bool minimum_failed, drop_failed, good;
+};
+
+class SchurInlierQualityHistory {
+ public:
+  TrackingQualityDecision decide(std::size_t observations, std::size_t minimum,
+      std::size_t maximum_drop, bool last_was_keyframe,
+      bool visual_correction, bool compare_previous = true) {
+    TrackingQualityDecision result{observations, previous_, minimum, maximum_drop,
+        available_, last_was_keyframe, visual_correction, compare_previous,
+        observations < minimum, false, false};
+    result.drop_failed = compare_previous && available_ && !last_was_keyframe
+        && previous_ > observations && previous_ - observations > maximum_drop;
+    result.good = visual_correction && !result.minimum_failed && !result.drop_failed;
+    // No correction breaks consecutive evidence. Bootstrap populations and
+    // missing visual updates cannot silently seed a later inlier comparison.
+    available_ = visual_correction;
+    previous_ = visual_correction ? observations : 0;
+    return result;
+  }
+  void reset() { previous_ = 0; available_ = false; }
+ private:
+  std::size_t previous_ = 0;
+  bool available_ = false;
+};
+}  // namespace rm27
